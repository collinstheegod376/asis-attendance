# ==============================================================================
# ADUN Attendance — Admin & Lecturer Web Portal Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your values from Supabase:
# Supabase Dashboard -> Settings -> API -> Project URL & Project API Keys (anon)
# ==============================================================================

VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
VITE_STUDENT_PWA_URL="https://your-student-pwa.vercel.app"

# NOTE: Never put your Supabase Service Role key in browser code!
