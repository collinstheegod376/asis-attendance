# ==============================================================================
# ADUN Attendance System - Supabase Environment Configuration Template
# ==============================================================================

# Supabase API URL & Service Role Key
# Note: SUPABASE_SERVICE_ROLE_KEY is server-side only. NEVER expose to browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Strict Device Binding Secrets (Required - system fails closed if missing)
# Minimum 32-byte high-entropy CSPRNG secret used for HMAC-SHA256 signing of adun_trusted_device cookies
DEVICE_COOKIE_SECRET=adun_strict_device_binding_hmac_secret_production_2026_min_32_chars

# Server-Side Salt for Hardware Fingerprint Hashes (Required - system fails closed if missing)
# Prevents rainbow table attacks on client-generated device fingerprints
FINGERPRINT_SALT=adun_hardware_fingerprint_salt_production_2026_min_32_chars

# Application URLs (for CORS / cookie origin verification)
APP_URL=https://attendance.adun.edu.ng
STUDENT_PWA_URL=https://attendance.adun.edu.ng
