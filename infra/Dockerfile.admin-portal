# Multi-stage Dockerfile for Admin & Lecturer Portal
FROM node:20-alpine AS builder

WORKDIR /app
COPY admin-portal/package*.json ./
RUN npm ci

COPY admin-portal/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
